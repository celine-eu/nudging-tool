# macOS
.DS_Store

# Environment and secrets
.env
.env.*
!.env.example

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs and local runtime files
*.log
*.pid

# IDE/editor settings
.idea/

# Dumpster output
.dumpster
skaffold

# Agent material is not published from this repository. What stays is the
# checker's own configuration; the knowledge, playbooks, plans and work live in
# the companion named by AGENTS_COMPANION.
.agents/*
!.agents/README.md
!.agents/harness.toml
!.agents/references.md
