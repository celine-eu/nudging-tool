
# Deployment posture (celine.sdk.posture): only `dev` accepts the local defaults (the
# database password below, client secret == client id, the SDK's local Keycloak).
# Unset or any other value is hardened and refuses them, and also requires
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY and CLICK_TRACKING_SECRET. `task run` exports dev.
CELINE_ENV=dev

DATABASE_URL=postgresql+asyncpg://postgres:securepassword123@host.docker.internal:15432/nudging

DEFAULT_LANG=it
MAX_PER_DAY_DEFAULT=3

VAPID_PUBLIC_KEY=your key
VAPID_PRIVATE_KEY=your key
VAPID_SUBJECT=your subject
# Required outside dev; in dev an empty one uses a fixed development secret (never the VAPID key).
CLICK_TRACKING_SECRET=dedicated secret for signed click tracking tokens
# Push-service hosts a subscription endpoint may name (REQ-0083); `*` = any public host.
# WEBPUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.apple.com,notify.windows.com
# Dev only: lift the endpoint rules for a local push stand-in. Refused outside CELINE_ENV=dev.
# WEBPUSH_ENDPOINT_RELAXED=false

# SMTP -- Email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=no-reply@example.com
